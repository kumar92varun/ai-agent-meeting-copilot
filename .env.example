# ============================================================
# ENVIRONMENT
# ============================================================
# NODE_ENV: controls app behavior
#   local      → direct email login, verbose logging, devtools on
#   testing    → Google OAuth required, mirrors production config
#   production → Google OAuth required, Sentry enabled
NODE_ENV=local

# Public URL of the app — used for OAuth redirects and outgoing email links
#   local:      http://localhost:3000
#   testing:    https://testing.yourdomain.com
#   production: https://yourdomain.com
APP_URL=http://localhost:3000

# Base path when the app is served under a sub-path (set at BUILD time and runtime)
#   root:      /   (default)
#   sub-path:  /ai-agents/standup-copilot/
NUXT_APP_BASE_URL=/

# Open-access mode — no login; every visitor is signed in as a shared "Guest Admin".
# Set AUTH_DISABLED at build time; NUXT_PUBLIC_AUTH_DISABLED overrides it at runtime.
AUTH_DISABLED=false
NUXT_PUBLIC_AUTH_DISABLED=false

# Secret used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ============================================================
# DATABASE  (PostgreSQL 16 + pgvector)
# ============================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
#   local:      postgresql://standup:changeme@localhost:5432/standup_intel
#   testing:    postgresql://standup:<pass>@<host>:5432/standup_intel_test
#   production: postgresql://standup:<pass>@<host>:5432/standup_intel
DATABASE_URL=postgresql://standup:changeme@localhost:5432/standup_intel

# ============================================================
# REDIS  (BullMQ job queue)
# ============================================================
# Format: redis://<host>:<port>
#   local:            redis://localhost:6379
#   testing/production: redis://<host>:6379
REDIS_URL=redis://localhost:6379

# ============================================================
# AUTHENTICATION
# ============================================================

# --- Google OAuth ---
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
# Set the authorized redirect URI to: <APP_URL>/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of email domains allowed to sign in via Google OAuth
# Leave as-is unless you need to allow external collaborators
ALLOWED_EMAIL_DOMAINS=crownstack.com

# ============================================================
# LLM  (Language Model — powers the LangGraph extraction pipeline)
# ============================================================
# Provider: openai | anthropic | google
LLM_PROVIDER=openai

# Model name for the chosen provider
# Recommended for Hinglish transcripts: gpt-4o or claude-sonnet-4-6
#   openai:    gpt-4o | gpt-4o-mini
#   anthropic: claude-sonnet-4-6 | claude-opus-4-7
#   google:    gemini-2.0-flash | gemini-2.5-pro
LLM_MODEL=gpt-4o

# API key for the chosen LLM provider
LLM_API_KEY=

# Sampling temperature — lower = more deterministic output (range: 0.0–1.0)
# 0.2 is recommended for structured extraction tasks
LLM_TEMPERATURE=0.2

# ============================================================
# EMBEDDINGS  (vector search used for task deduplication)
# ============================================================
# Note: Anthropic has no embeddings API.
# Keep EMBEDDING_PROVIDER=openai even when LLM_PROVIDER=anthropic.
EMBEDDING_PROVIDER=openai

# Embedding model — text-embedding-3-small is sufficient and cost-effective
EMBEDDING_MODEL=text-embedding-3-small

# API key for the embedding provider (usually the same as LLM_API_KEY for OpenAI)
EMBEDDING_API_KEY=

# ============================================================
# EMAIL  (daily risk digest + risk alert notifications)
# ============================================================
# Provider: sendgrid | ses | smtp
#   local: leave EMAIL_PROVIDER blank or use smtp with a local mail catcher
EMAIL_PROVIDER=sendgrid

# Address shown in the From header of all outgoing emails
EMAIL_FROM_ADDRESS=noreply@crownstack.com
EMAIL_FROM_NAME=Standup Intelligence

# SendGrid API key — required when EMAIL_PROVIDER=sendgrid
# Leave blank for local development (emails will be skipped/logged)
SENDGRID_API_KEY=

# ============================================================
# OBSERVABILITY
# ============================================================
# Sentry DSN — leave blank for local dev, set for testing & production
# Get from: sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# Pino structured log level: trace | debug | info | warn | error | fatal
#   local:      debug
#   testing:    info
#   production: warn
LOG_LEVEL=debug

# ============================================================
# TIMEZONE
# ============================================================
# Used for IST-aware deadline resolution ("kal", "parso") and cron scheduling
DEFAULT_TIMEZONE=Asia/Kolkata
