# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=                   # 32+ random characters

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/standup_intel

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=crownstack.com

# LLM
LLM_PROVIDER=openai               # openai | anthropic | google
LLM_MODEL=gpt-4o                  # Recommended for Hinglish: gpt-4o or claude-sonnet-4-5+
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=                # often same as LLM_API_KEY

# Email
EMAIL_PROVIDER=sendgrid           # sendgrid | ses | smtp
EMAIL_FROM_ADDRESS=noreply@crownstack.com
EMAIL_FROM_NAME=Standup Intelligence
SENDGRID_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
